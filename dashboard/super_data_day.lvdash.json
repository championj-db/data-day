{
  "datasets": [
    {
      "name": "a80da128",
      "displayName": "Super Summary",
      "queryLines": [
        "SELECT COUNT(DISTINCT fund_name) AS fund_count, ROUND(SUM(total_fund_investments_m)/1000,1) AS total_inv_bn, ROUND(AVG(illiquid_pct),1) AS avg_illiquid_pct FROM workspace.data_day.v_super_illiquidity_peer"
      ]
    },
    {
      "name": "90531b17",
      "displayName": "Allocation by Classification",
      "queryLines": [
        "SELECT rse_regulatory_classification AS classification, ROUND(AVG(equity_m/NULLIF(total_fund_investments_m,0)*100),1) AS avg_equity_pct, ROUND(AVG(illiquid_pct),1) AS avg_illiquid_pct, ROUND(AVG(fixed_income_m/NULLIF(total_fund_investments_m,0)*100),1) AS avg_fi_pct, ROUND(AVG(cash_m/NULLIF(total_fund_investments_m,0)*100),1) AS avg_cash_pct FROM workspace.data_day.v_super_illiquidity_peer GROUP BY rse_regulatory_classification"
      ]
    },
    {
      "name": "3444a7e6",
      "displayName": "AUM by Profit Status",
      "queryLines": [
        "SELECT rse_licensee_profit_status AS profit_status, ROUND(SUM(total_fund_investments_m)/1000,1) AS total_inv_bn FROM workspace.data_day.v_super_illiquidity_peer WHERE rse_licensee_profit_status IS NOT NULL GROUP BY rse_licensee_profit_status"
      ]
    },
    {
      "name": "50894a23",
      "displayName": "Illiquidity vs Size",
      "queryLines": [
        "SELECT fund_name, rse_regulatory_classification AS classification, ROUND(illiquid_pct,1) AS illiquid_pct, ROUND(total_fund_investments_m,0) AS total_investments_m FROM workspace.data_day.v_super_illiquidity_peer WHERE total_fund_investments_m>0"
      ]
    },
    {
      "name": "662a52ec",
      "displayName": "Top Illiquid Funds",
      "queryLines": [
        "SELECT fund_name, rse_regulatory_classification AS classification, ROUND(illiquid_pct,1) AS illiquid_pct, ROUND(segment_avg_illiquid_pct,1) AS peer_avg_pct, ROUND(vs_peer_avg_pp,1) AS vs_peer_pp, ROUND(total_fund_investments_m,0) AS total_m, peer_comparison FROM workspace.data_day.v_super_illiquidity_peer ORDER BY illiquid_pct DESC LIMIT 15"
      ]
    },
    {
      "name": "6fc569ee",
      "displayName": "Total Industry Investments",
      "queryLines": [
        "SELECT try_to_date(quarter,'MMM yyyy') AS quarter_date, ROUND(SUM(value_m)/1000,0) AS total_bn FROM workspace.data_day.super_performance WHERE asset_class='Total investments' AND value_m>10 AND try_to_date(quarter,'MMM yyyy') IS NOT NULL GROUP BY 1 ORDER BY 1"
      ]
    },
    {
      "name": "26c0e70f",
      "displayName": "Asset Allocation Mix Over Time",
      "queryLines": [
        "SELECT try_to_date(quarter,'MMM yyyy') AS quarter_date, asset_class, ROUND(SUM(value_m)/1000,1) AS value_bn FROM workspace.data_day.super_performance WHERE asset_class IN ('Cash','Fixed income','Equity','Property','Infrastructure','Other','Commodities') AND value_m>10 AND try_to_date(quarter,'MMM yyyy') IS NOT NULL GROUP BY 1,2 ORDER BY 1"
      ]
    }
  ],
